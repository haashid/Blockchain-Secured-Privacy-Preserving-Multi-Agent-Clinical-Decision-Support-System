[TEMPLATE]
# ============================================================
# Secure Multi-Agent AI Coordination Framework
# Environment Configuration
# ============================================================

# Application
APP_ENV=development
APP_SECRET=change-me-to-a-random-64-char-string
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
APP_LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://multichain:multichain_secret@localhost:5432/multichain_db

# AI Agent Configuration
AI_MODE=mock
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Groq LLM Configuration
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# Hyperledger Fabric
FABRIC_NETWORK=development
FABRIC_CHANNEL=ai-coordination-channel
FABRIC_CHAINCODE=ai-coordination
FABRIC_MSP_ID=Org1MSP
FABRIC_CERT_PATH=./blockchain/network/crypto-config/peerOrganizations/org1.ai-coordination.com/users/Admin@org1.ai-coordination.com/msp/signcerts/cert.pem
FABRIC_KEY_PATH=./blockchain/network/crypto-config/peerOrganizations/org1.ai-coordination.com/users/Admin@org1.ai-coordination.com/msp/keystore/
FABRIC_TLS_CERT_PATH=./blockchain/network/crypto-config/peerOrganizations/org1.ai-coordination.com/peers/peer0.org1.ai-coordination.com/tls/ca.crt
FABRIC_GATEWAY_ENDPOINT=localhost:7051
FABRIC_ORG1_MSP=Org1MSP
FABRIC_ORG2_MSP=Org2MSP

# Object Storage (MinIO)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=agent-storage
MINIO_SECURE=false

# Encryption
ENCRYPTION_KEY=change-me-to-a-random-32-byte-hex-string

# Consensus
CONSENSUS_THRESHOLD=0.70

# Tamper Simulation (for demo)
SIMULATE_TAMPERING=false

# JWT Authentication
JWT_SECRET=change-me-to-a-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
